{
  "name": "project-hibernate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "npm run typecheck && vite build --config apps/desktop/vite.config.ts && node scripts/build-extensions.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --no-bundle",
    "desktop:package": "node scripts/package-desktop.mjs",
    "test:browser": "node tests/browser-integration.mjs",
    "test:adapter": "node tests/browser-adapter.mjs",
    "vscode:package": "node scripts/build-extensions.mjs && node scripts/package-vscode.mjs",
    "test:vscode": "node tests/vscode-integration.mjs",
    "test:vscode-close": "node tests/vscode-close-reopen.mjs",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "test:checkpoint": "node tests/project-checkpoint.mjs",
    "test:discovery": "node tests/project-discovery.mjs",
    "test:project-hibernate": "node tests/project-hibernate.mjs",
    "test:project-vscode": "node tests/project-vscode.mjs",
    "test:chrome-cold": "node tests/chrome-cold-restore.mjs",
    "test:vscode-cold": "node tests/vscode-cold-restore.mjs",
    "test:packaged-v1": "node tests/packaged-v1.mjs",
    "test:reviewed-browser": "node tests/reviewed-browser.mjs",
    "test:quick-sleep": "node tests/quick-sleep.mjs",
    "test:terminal": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/terminal-integration.ps1",
    "native:build": "cargo build --manifest-path native/Cargo.toml --bin hibernate-host"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.99.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
